# =============================================================================
# EBA — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# NUNCA commite o arquivo .env
# =============================================================================

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
APP_ENV=development                      # development | staging | production
APP_NAME="Enterprise Billing Automation"
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# SECRET_KEY: mínimo 32 chars. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32_chars_minimum

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=eba_dev
POSTGRES_USER=eba_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# URL completa (gerada automaticamente a partir das vars acima, mas pode ser sobrescrita)
# DATABASE_URL=postgresql+asyncpg://eba_user:password@db:5432/eba_dev

# Para testes (banco separado)
TEST_DATABASE_URL=postgresql+asyncpg://eba_user:CHANGE_ME_strong_password_here@localhost:5432/eba_test

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0

# URL do Celery broker
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis_password@redis:6379/1

# -----------------------------------------------------------------------------
# MINIO (Object Storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET_DOCUMENTS=eba-documents
MINIO_SECURE=false                       # true em produção (HTTPS)
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=900   # 15 minutos

# -----------------------------------------------------------------------------
# E-MAIL
# -----------------------------------------------------------------------------
MAIL_SERVER=mailhog                      # mailhog em dev; SMTP real em prod
MAIL_PORT=1025
MAIL_USERNAME=                           # vazio no MailHog
MAIL_PASSWORD=                           # vazio no MailHog
MAIL_FROM=noreply@eba.local
MAIL_FROM_NAME="EBA Platform"
MAIL_TLS=false
MAIL_SSL=false

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Separe múltiplas origens com vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_DEFAULT=100/minute

# -----------------------------------------------------------------------------
# SENTRY (Monitoramento de Erros)
# -----------------------------------------------------------------------------
# Deixe vazio em desenvolvimento para desabilitar
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1           # 10% dos traces em produção

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                       # console (dev) | json (prod)

# -----------------------------------------------------------------------------
# CELERY / WORKERS
# -----------------------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_ALWAYS_EAGER=false          # true em testes unitários

# -----------------------------------------------------------------------------
# PRIMEIRO SUPERADMIN (seed de bootstrap)
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@eba.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password
BOOTSTRAP_ADMIN_NAME="EBA Administrator"

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
FEATURE_AUDIT_LOG=true
FEATURE_RATE_LIMITING=true
FEATURE_SENTRY=false

