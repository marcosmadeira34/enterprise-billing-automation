# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/build/
frontend/out/

# Testing
frontend/coverage/

# ---------------------------------------------------------------------------
